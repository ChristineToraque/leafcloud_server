# --- Server Configuration ---
PORT=8000

# --- Database Configuration ---
# Use either a full DATABASE_URL or the individual components below
DATABASE_URL=postgresql://user:password@localhost:5432/leafcloud3
DB_USER=fil
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=leafcloud3

# --- Security & JWT ---
# Generate a secure key using: openssl rand -hex 32
SECRET_KEY=your-super-secret-key-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Admin Initial Seeding ---
ADMIN_EMAIL=admin@leafcloud.com
ADMIN_NAME=Super Admin
ADMIN_PASSWORD=admin123

# --- Image Processing ---
SOURCE_DIR=images
OUTPUT_DIR=cropped_dataset
CROP_SIZE=224
GREEN_THRESHOLD=30.0

# --- AI Model ---
AI_MODEL_PATH=leafcloud_multimodal_v3_20260520_1920.keras
